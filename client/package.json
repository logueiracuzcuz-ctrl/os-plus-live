{
  "name": "@screenshare/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Share your screen with friends in real time",
  "author": "ScreenShare",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:vite": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=esm --outdir=dist/main --external:electron --alias:@screenshare/shared=../shared/dist/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outdir=dist/preload --external:electron --alias:@screenshare/shared=../shared/dist/index.js",
    "build": "npm run build:vite && npm run build:main && npm run build:preload",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "clean": "rimraf dist release",
    "test": "jest --config jest.config.cjs --passWithNoTests"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "31.7.7",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
